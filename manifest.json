{
  "manifest_version": 3,
  "name": "ImPares",
  "version": "2.1.0",
  "description": "Descarga masiva y organizada de documentos digitalizados del Portal de Archivos Españoles (PARES)",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://pares.cultura.gob.es/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon16.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  },
  "icons": {
    "16": "img/icon16.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pares.cultura.gob.es/ParesBusquedas20/catalogo/show/*",
        "https://pares.cultura.gob.es/ParesBusquedas20/catalogo/description/*"
      ],
      "js": ["js/content.js"],
      "run_at": "document_idle"
    }
  ]
}
